# Kopieer naar .env (staat in .gitignore). Laat leeg in ontwikkeling: de app zoekt de api dan zelf
# op poort 4000 van de computer waarop Expo draait.
#
# Adres van de KBC Loop-api. Verplicht https voor productiebuilds (iOS/Android).
EXPO_PUBLIC_API_URL=
# Optioneel. Geen geheim: EXPO_PUBLIC_-waarden zitten leesbaar in de app-bundel.
EXPO_PUBLIC_API_KEY=
